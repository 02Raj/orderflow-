JWT_SECRET=change-me-before-production
JWT_EXPIRES_IN=12h
# Production password reset delivery (requires a verified sender in Resend).
# RESEND_API_KEY=
# PASSWORD_RESET_FROM=OrderNFlow <support@example.com>
# Platform admin is enabled when configured. In production use a unique password
# of at least 16 characters and a random session secret of at least 32 characters.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_SESSION_SECRET=
TRIAL_DAYS=14
PRICE_LABEL=$29 / month
APP_PUBLIC_URL=http://127.0.0.1:43123
# Production (after you buy the domain): https://ordernflow.com

# Production: paste the Supabase Postgres Transaction Pooler URI (port 6543). Leave unset for local PGlite.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# PGLITE_PATH=.data/pglite

# Dodo Payments (Merchant of Record — Test Mode by default)
# NEXT_PUBLIC_PAYMENTS_ENABLED=true
# DODO_PAYMENTS_ENV=test_mode
# DODO_PAYMENTS_API_KEY=
# DODO_PRODUCT_ID=
# DODO_PAYMENTS_WEBHOOK_KEY=

# Optional Stripe fallback
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
