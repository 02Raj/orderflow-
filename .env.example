JWT_SECRET=change-me-before-production
JWT_EXPIRES_IN=12h
# Production password reset delivery (requires a verified sender in Resend).
# RESEND_API_KEY=
# PASSWORD_RESET_FROM=OrderNFlow <support@example.com>
# Platform admin is enabled when configured. In production use a unique password
# of at least 16 characters and a random session secret of at least 32 characters.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_SESSION_SECRET=
TRIAL_DAYS=45
PRICE_LABEL=$29 / month
APP_PUBLIC_URL=http://127.0.0.1:43123
# Production (after you buy the domain): https://helloorderflow.com

# Production: paste the Supabase Postgres URI. Leave unset for local PGlite.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# PGLITE_PATH=.data/pglite

# Production: Stripe subscription. Leave unset to use mock checkout.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
